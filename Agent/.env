# para o agente chamar seu backend Node
BACKEND_BASE=http://127.0.0.1:3000

# opcional (só se for usar o mini-agente de verificação do emissor)
OPENAI_API_KEY=
# timeouts e regras
TIMEOUT_S=5
H_MIN=10
SIM_ALUNO=92
SIM_DUP_FRACA=88

# OCR
OCR_SAVE_IMAGES=0 
OCR_DPI=250
OCR_PAGE_LIMIT=6
OCR_LANGS=por+eng
OCR_MODE=force_ocr
OCR_DEBUG=1
OCR_PREVIEW_CHARS=800

# chave para proteger o /validate do agente
AGENT_API_KEY=docverifier_local_71f8f7a2e0c94a1fbe3f0a6f1b3b9c4d

POPPLER_PATH=C:\Program Files\poppler\poppler-24.08.0\Library\bin
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

EMISSOR_FORCE_FREE=1
EMISSOR_CONF_MIN=0.85
# opcional, se usar cache com outro limiar:
EMISSOR_CACHE_CONF_MIN=0.80
//schema.prisma

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  email    String   @unique
  password String
  ra       String   @unique
  curso    String
  tipo     String   
  certificados Certificado[]
}

enum CertStatus {
  PENDENTE
  ACEITO
  RECUSADO
  AJUSTAR
}

model Certificado {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  titulo          String
  tipoAtividade   String
  dataEnvio       DateTime
  horasAtribuidas Int
  urlPDF          String
  status          CertStatus @default(PENDENTE)
  userId          String   @db.ObjectId // <-- Add this
  
  user            User     @relation(fields: [userId], references: [id])

  // --- novos (mínimo viável) ---
  instituicao       String?
  semestre          String?
  relacaoComCurso   Boolean?
  nomeNoCertificado String?
  extraidoRaw       Json?
  dataConclusao     DateTime?

  // --- NOVOS ---
  fileHashSHA256     String?  // duplicidade forte (match exato)

  @@index([fileHashSHA256])
  @@index([instituicao, dataConclusao])
  @@index([userId, dataConclusao])
  @@index([titulo, instituicao])
}

model Issuer {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  isTrusted  Boolean  @default(false)
  trustLevel Float    @default(0.0) // 0..1 (ex.: >=0.8 = confiável)
  notes      String?
  updatedAt  DateTime @updatedAt
}

model AuditLog {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  certificadoId String   @db.ObjectId
  status        CertStatus
  reason        String
  evidence      Json         // evidencias[]
  stateSnap     Json?        // estado final do grafo (sanitizado)
  createdAt     DateTime @default(now())
}
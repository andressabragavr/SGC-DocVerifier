//schema.prisma

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  email    String   @unique
  password String
  ra       String   @unique
  curso    String
  tipo     String   
  certificados Certificado[]
}

model Certificado {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  titulo          String
  tipoAtividade   String
  dataEnvio       DateTime
  horasAtribuidas Int
  urlPDF          String
  status          String
  userId          String   @db.ObjectId // <-- Add this
  
  user            User     @relation(fields: [userId], references: [id])

  // --- novos (mínimo viável) ---
  instituicao       String?
  semestre          String?
  relacaoComCurso   Boolean?
  nomeNoCertificado String?
  extraidoRaw       Json?
  dataConclusao     DateTime?

  // --- NOVOS ---
  fileHashSHA256     String?
}